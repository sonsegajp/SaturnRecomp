uint vr(uint off) { return regs.d[off >> 1] & 0xffffu; }

int sextract(uint v, uint lo, uint width)
{
    uint maskv = width == 32u ? 0xffffffffu : ((1u << width) - 1u);
    uint x = (v >> lo) & maskv;
    if ((x & (1u << (width - 1u))) != 0u) x |= ~maskv;
    return int(x);
}
int sext19(int v) { v &= 0x7ffff; return (v & 0x40000) != 0 ? v - 0x80000 : v; }

vec3 rgb555(uint p)
{
    vec3 c = vec3(float(p & 31u), float((p >> 5) & 31u), float((p >> 10) & 31u));
    return floor(c * 255.0 / 31.0 + 0.5) / 255.0;
}

vec3 cram_colour(uint index)
{
    uint mode = (vr(0x0e) >> 12) & 3u;
    if (mode == 2u) {
        uint o = (index * 4u) & 0xffcu;
        return vec3(float(cb(o+3u)), float(cb(o+2u)), float(cb(o+1u))) / 255.0;
    }
    uint o = (index * 2u) & (mode == 0u ? 0x7feu : 0xffeu);
    return rgb555((cb(o) << 8) | cb(o+1u));
}

bool cram_msb(uint index)
{
    uint mode = (vr(0x0e) >> 12) & 3u;
    uint o = mode == 2u ? ((index * 4u) & 0xffcu) : ((index * 2u) & 0xffeu);
    return (cb(o) & 0x80u) != 0u;
}

vec3 blend(vec3 top, vec3 bottom, uint topw, bool add)
{
    if (add) return min(top + bottom, vec3(1.0));
    return bottom + (top - bottom) * (float(topw) / 32.0);
}

ivec3 colour_offset(int layer)
{
    uint en = vr(0x110), sl = vr(0x112);
    if (layer < 0 || layer > 6 || (en & (1u << uint(layer))) == 0u) return ivec3(0);
    uint base = (sl & (1u << uint(layer))) != 0u ? 0x11au : 0x114u;
    ivec3 c = ivec3(int(vr(base)&0x1ffu), int(vr(base+2u)&0x1ffu), int(vr(base+4u)&0x1ffu));
    if ((c.r & 0x100) != 0) c.r -= 0x200;
    if ((c.g & 0x100) != 0) c.g -= 0x200;
    if ((c.b & 0x100) != 0) c.b -= 0x200;
    return c;
}
vec3 apply_offset(vec3 c, int layer)
{
    return clamp(c + vec3(colour_offset(layer)) / 255.0, vec3(0), vec3(1));
}

struct Dot { vec3 c; int opaque; int sp; int code; };

uint plane_addr(uint v, int cellsz, bool one_word, uint planew, uint planeh)
{
    uint deca = planew + planeh - 2u, multi = planew * planeh;
    if (one_word) {
        if (cellsz == 1) return ((v & 0x3fu) >> deca) * (multi * 0x2000u);
        return (v >> deca) * (multi * 0x800u);
    }
    if (cellsz == 1) return ((v & 0x1fu) >> deca) * (multi * 0x4000u);
    return ((v & 0x7fu) >> deca) * (multi * 0x1000u);
