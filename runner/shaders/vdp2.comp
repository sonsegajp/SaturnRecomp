#version 450

/* VDP2 has no native framebuffer. This shader samples Saturn VRAM/CRAM and
 * the Vulkan-owned VDP1 framebuffers, resolves per-dot priority, colour
 * calculation, windows, shadow and colour offset, and writes the scanout. */
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 1) readonly buffer V2Ram { uint d[]; } v2ram;
layout(std430, binding = 2) readonly buffer CRam  { uint d[]; } cram;
layout(std430, binding = 3) readonly buffer Regs  { uint d[]; } regs;
layout(std430, binding = 5) readonly buffer V1FB  { uint d[]; } fb;
layout(std430, binding = 6) readonly buffer Mesh  { uint d[]; } meshfb;
layout(rgba8, binding = 7) uniform writeonly image2D scanout;

const uint V2MASK = 0x7ffffu;
const uint FB_PIXELS = 512u * 256u;

uint vb(uint a) { a &= V2MASK; return (v2ram.d[a >> 2] >> ((a & 3u) * 8u)) & 255u; }
