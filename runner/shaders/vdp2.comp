bool suppressed(uint wb,int x,int y,bool spwin,bool allowsp)
{
    bool en0=(wb&2u)!=0u,en1=(wb&8u)!=0u,ens=allowsp&&(wb&0x20u)!=0u;
    if(!en0&&!en1&&!ens)return false;
