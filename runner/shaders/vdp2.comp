    if(en0){bool q=in_window(x,y,0)!=((wb&1u)!=0u);v=andm?(v&&q):(v||q);}
    if(en1){bool q=in_window(x,y,1)!=((wb&4u)!=0u);v=andm?(v&&q):(v||q);}
    if(ens){bool q=spwin!=((wb&0x10u)!=0u);v=andm?(v&&q):(v||q);}
    return v;
