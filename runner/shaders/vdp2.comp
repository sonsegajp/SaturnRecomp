    if((vr(lwt)&0x8000u)!=0u){uint a=((vr(lwt)&7u)<<17)|((vr(lwt+2u)&0xfffeu)<<1);a+=uint(y)*4u;sx=sextract(v16(a),0,16);ex=sextract(v16(a+2u),0,16);}
    if((vr(0)&3u)<2u){sx>>=1;ex>>=1;}return x>=sx&&x<=ex;
